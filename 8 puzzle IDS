def get_inversions(state):
    """Calculates inversions in a state (ignoring blank space 0)."""
    tiles = [tile for tile in state if tile != 0]
    return sum(
        1 for i in range(len(tiles)) for j in range(i + 1, len(tiles)) if tiles[i] > tiles[j]
    )


def is_solvable(start_state, goal_state):
    """Checks if moving from start_state to goal_state is solvable by matching inversion parity."""
    return (get_inversions(start_state) % 2) == (get_inversions(goal_state) % 2)


def get_neighbors(state):
    """Generates valid adjacent states by sliding tile into the blank (0)."""
    neighbors = []
    zero_idx = state.index(0)
    row, col = divmod(zero_idx, 3)

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right

    for dr, dc in moves:
        r, c = row + dr, col + dc
        if 0 <= r < 3 and 0 <= c < 3:
            new_zero_idx = r * 3 + c
            state_list = list(state)
            state_list[zero_idx], state_list[new_zero_idx] = (
                state_list[new_zero_idx],
                state_list[zero_idx],
            )
            neighbors.append(tuple(state_list))

    return neighbors


def depth_limited_search(current, goal_state, current_limit, path, visited):
    """
    Recursive Depth-Limited Search (DLS).
    The level is fixed here by 'current_limit'.
    """
    if current == goal_state:
        return path

    # LEVEL CUTOFF FIX: Stop expanding nodes when path length reaches the current limit
    if len(path) - 1 >= current_limit:
        return None

    for neighbor in get_neighbors(current):
        if neighbor not in visited:
            visited.add(neighbor)
            result = depth_limited_search(neighbor, goal_state, current_limit, path + [neighbor], visited)
            if result is not None:
                return result
            # Backtrack so other branches at this depth limit can evaluate this state
            visited.remove(neighbor)

    return None


def solve_8_puzzle_ids(start_state, goal_state, max_level_limit):
    """
    Iterative Deepening Search (IDS).
    Iterates depth limits from 0 up to user-specified max_level_limit.
    """
    for level in range(max_level_limit + 1):
        print(f"-> Searching at Level Limit: {level}...")
        visited = {start_state}
        result = depth_limited_search(start_state, goal_state, level, [start_state], visited)
        if result is not None:
            return result, level

    return None, max_level_limit


def get_user_state(state_name):
    """Prompts the user to enter a 3x3 board state."""
    print(f"\n--- Enter the {state_name.upper()} STATE ---")
    print("Use numbers 0-8 separated by spaces (0 represents the blank space):")

    board = []
    for i in range(3):
        while True:
            try:
                row_input = input(f"Enter Row {i+1} (3 numbers): ").strip().split()
                row_nums = [int(num) for num in row_input]
                if len(row_nums) != 3:
                    print("Error: Exactly 3 numbers required per row.")
                    continue
                board.extend(row_nums)
                break
            except ValueError:
                print("Error: Invalid input. Enter integers only.")

    if sorted(board) != list(range(9)):
        print("\nInvalid input! State must contain numbers 0 through 8 with no duplicates.")
        return None

    return tuple(board)


def print_board(state):
    """Prints a 3x3 grid cleanly."""
    for i in range(0, 9, 3):
        print(" ".join(str(x) if x != 0 else "_" for x in state[i:i+3]))
    print()


# Execution Block
if __name__ == "__main__":
    start = get_user_state("initial")
    if start is None:
        exit()

    goal = get_user_state("goal")
    if goal is None:
        exit()

    # User inputs fixed maximum depth bound
    while True:
        try:
            max_level = int(input("\nEnter Maximum Depth Limit for IDS (e.g., 20 or 30): "))
            if max_level >= 0:
                break
            print("Please enter a non-negative integer.")
        except ValueError:
            print("Invalid input. Enter an integer.")

    print("\n" + "=" * 40)
    print("INITIAL STATE:")
    print_board(start)

    print("GOAL STATE:")
    print_board(goal)
    print(f"FIXED MAX DEPTH LIMIT: {max_level}")
    print("=" * 40 + "\n")

    if not is_solvable(start, goal):
        print("Error: This goal state cannot be reached from the given initial state!")
        print("Reason: Mismatched inversion parity (one is even, the other is odd).")
    else:
        solution, reached_level = solve_8_puzzle_ids(start, goal, max_level)

        if solution:
            print(f"\nGoal reached at depth {reached_level} in {len(solution) - 1} steps!\n")
            print("================ PATH TO GOAL ================\n")
            for step, state in enumerate(solution):
                if step == 0:
                    print(f"Step {step} (Initial State):")
                elif step == len(solution) - 1:
                    print(f"Step {step} (Goal State Reached):")
                else:
                    print(f"Step {step}:")
                print_board(state)
        else:
            print(f"\nNo solution found within the fixed maximum limit of {max_level} levels.")
